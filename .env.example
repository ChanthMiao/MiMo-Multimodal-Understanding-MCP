# Xiaomi MiMo API Key
# Get your API key from: https://platform.xiaomimimo.com
MIMO_API_KEY=your_api_key_here

# MiMo API Base URL (optional, defaults to https://api.xiaomimimo.com/v1)
# MIMO_API_BASE=https://api.xiaomimimo.com/v1

# Default model (optional, defaults to mimo-v2.6-flash)
# Supported: mimo-v2.6-pro, mimo-v2.6-flash, mimo-v2.6-pro-ultraspeed
# "mimo-v2.6" is accepted as an alias for mimo-v2.6-flash
# MIMO_MODEL=mimo-v2.6-flash
